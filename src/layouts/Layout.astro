---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "See the whole system - Make the right move | Circular Ecosystems | Western Australia",
  description = "Decision Intelligence for Industrial Zones and Regional Corridors. Circular Ecosystems tightens evidence, exposes risk, and tests interventions before capital and approval lock in a corridor for decades."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <link rel="icon" type="image/png" href="/CircularEcosystemsFav.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="apple-touch-icon" href="/CircularEcosystemsFav.png">
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Preconnect & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=DM+Mono:wght@400;500&family=Cormorant+Garamond:ital,wght@0,500;1,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
