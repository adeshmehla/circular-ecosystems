<script is:inline>
// nav solid on scroll
const nav=document.getElementById('nav');
if (nav) {
  addEventListener('scroll',()=>{nav.classList.toggle('solid',window.scrollY>40)});
}

// reveal observer
const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.14,rootMargin:'0px 0px -6% 0px'});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

// hero constellation
(function(){
  const c=document.getElementById('net');if(!c)return;
  const x=c.getContext('2d');
  let w,h,nodes,mx=-999,my=-999;
  const COL='199,249,208';
  function size(){w=c.width=window.innerWidth;h=c.height=Math.max(c.parentElement.offsetHeight,window.innerHeight);init()}
  function init(){
    const n=Math.min(58,Math.round(w*h/28000));
    nodes=Array.from({length:n},()=>({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.22,vy:(Math.random()-.5)*.22,r:Math.random()*1.6+.6}));
  }
  function frame(){
    x.clearRect(0,0,w,h);
    for(const p of nodes){
      p.x+=p.vx;p.y+=p.vy;
      if(p.x<0||p.x>w)p.vx*=-1; if(p.y<0||p.y>h)p.vy*=-1;
      const dx=p.x-mx,dy=p.y-my,dm=Math.hypot(dx,dy);
      if(dm<140){p.x+=dx/dm*.5;p.y+=dy/dm*.5}
    }
    for(let i=0;i<nodes.length;i++){
      for(let j=i+1;j<nodes.length;j++){
        const a=nodes[i],b=nodes[j],d=Math.hypot(a.x-b.x,a.y-b.y);
        if(d<132){x.strokeStyle='rgba('+COL+','+(.13*(1-d/132))+')';x.lineWidth=1;x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.stroke()}
      }
    }
    for(const p of nodes){x.fillStyle='rgba('+COL+',.55)';x.beginPath();x.arc(p.x,p.y,p.r,0,7);x.fill()}
    requestAnimationFrame(frame);
  }
  addEventListener('resize',size);
  addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY});
  addEventListener('mouseout',()=>{mx=-999;my=-999});
  size();frame();
})();

// service accordion, jump chips, and briefing prefill
(function(){
  const items=[...document.querySelectorAll('.svc-item')];
  const jump=document.getElementById('jump');

  function setHeight(item){
    const body=item.querySelector('.svc-body');
    if(body) {
      body.style.maxHeight=item.classList.contains('open')?body.scrollHeight+'px':'0px';
    }
  }
  function openItem(item,scroll){
    items.forEach(o=>{
      const on=o===item;
      o.classList.toggle('open',on);
      const head = o.querySelector('.svc-head');
      if(head) head.setAttribute('aria-expanded',on?'true':'false');
      setHeight(o);
    });
    document.querySelectorAll('.jchip').forEach(ch=>ch.classList.toggle('on',ch.dataset.target===item.id));
    if(scroll){
      const y=item.getBoundingClientRect().top+window.scrollY-96;
      scrollTo({top:y,behavior:'smooth'});
    }
  }

  items.forEach(item=>{
    const catEl=item.querySelector('.svc-cat');
    const cat=catEl ? catEl.textContent.split('\u00b7')[0].trim() : '';
    const chip=document.createElement('button');
    chip.className='jchip';chip.dataset.target=item.id;
    chip.textContent=item.dataset.svc+'  '+cat;
    chip.addEventListener('click',()=>openItem(item,true));
    if(jump) jump.appendChild(chip);

    const headBtn = item.querySelector('.svc-head');
    if (headBtn) {
      headBtn.addEventListener('click',()=>{
        const isOpen=item.classList.contains('open');
        if(isOpen){
          item.classList.remove('open');
          headBtn.setAttribute('aria-expanded','false');
          setHeight(item);
          document.querySelectorAll('.jchip').forEach(ch=>ch.classList.remove('on'));
        }else{openItem(item,false)}
      });
    }
    setHeight(item);
  });
  
  addEventListener('resize',()=>items.forEach(setHeight));

  // briefing prefill
  const field=document.getElementById('serviceField');
  document.querySelectorAll('.svc-book').forEach(b=>{
    b.addEventListener('click',()=>{
      if(field)field.value=b.dataset.service;
      const contactSec = document.getElementById('contact');
      if (contactSec) contactSec.scrollIntoView({behavior:'smooth'});
    });
  });

  // deep link: /services?service=04 or ?service=4 opens that engagement
  const q=new URLSearchParams(window.location.search).get('service');
  if(q){
    const formattedNum = q.padStart(2,'0');
    const target=items.find(i=>i.dataset.svc===formattedNum);
    if(target)setTimeout(()=>openItem(target,true),320);
  }
})();

// ============================================================
// SERVICES FORM — Wix submission (outside accordion IIFE)
// ============================================================
(function() {
  console.log('[Services Form] Initialising form handler...');
  const servicesForm = document.getElementById("services-form");

  if (!servicesForm) {
    console.error('[Services Form] ERROR: #services-form element not found in DOM!');
    return;
  }

  console.log('[Services Form] Form element found. Attaching submit listener.');

  servicesForm.addEventListener("submit", async function(e) {
    e.preventDefault();
    console.log('[Services Form] Submit triggered.');

    const errorDiv = document.getElementById("svc-form-error");
    const successDiv = document.getElementById("svc-form-success");
    const submitBtn = document.getElementById("svc-submit-btn");
    const fieldsContainer = servicesForm.querySelector(".form-fields-container");
    const footerAction = servicesForm.querySelector(".form-footer-action");

    // Reset error state
    if (errorDiv) {
      errorDiv.textContent = "";
      errorDiv.classList.add("hidden");
    }

    const nameEl = document.getElementById("svc-name");
    const orgEl = document.getElementById("svc-org");
    const emailEl = document.getElementById("svc-email");
    const serviceEl = document.getElementById("serviceField");
    const decisionEl = document.getElementById("svc-decision");

    const name = nameEl ? nameEl.value.trim() : "";
    const organisation = orgEl ? orgEl.value.trim() : "";
    const email = emailEl ? emailEl.value.trim() : "";
    const service = serviceEl ? serviceEl.value.trim() : "";
    const decision = decisionEl ? decisionEl.value.trim() : "";

    console.log('[Services Form] Values collected:', { name, organisation, email, service, decision });

    // Validation
    if (!name) {
      console.warn('[Services Form] Validation failed: name is empty.');
      if (errorDiv) { errorDiv.textContent = "Please enter your name."; errorDiv.classList.remove("hidden"); }
      return;
    }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      console.warn('[Services Form] Validation failed: invalid email.');
      if (errorDiv) { errorDiv.textContent = "Please enter a valid email address."; errorDiv.classList.remove("hidden"); }
      return;
    }

    // Disable submit button
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = "Sending..."; }

    try {
      console.log('[Services Form] POSTing to /api/services...');
      const res = await fetch("/api/services", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, organisation, email, service, decision })
      });

      console.log('[Services Form] Response status:', res.status);
      const data = await res.json();
      console.log('[Services Form] Response data:', data);

      if (res.ok && data.success) {
        console.log('[Services Form] Submission successful!');
        if (fieldsContainer) fieldsContainer.style.display = "none";
        if (footerAction) footerAction.style.display = "none";
        if (successDiv) successDiv.classList.remove("hidden");
      } else {
        console.error('[Services Form] Server returned error:', data.error);
        if (errorDiv) {
          errorDiv.textContent = data.error || "Submission failed. Please try again.";
          errorDiv.classList.remove("hidden");
        }
      }
    } catch (err) {
      console.error('[Services Form] Network/fetch error:', err);
      if (errorDiv) {
        errorDiv.textContent = "Network error. Please try again or email us directly at hello@circularecosystems.io.";
        errorDiv.classList.remove("hidden");
      }
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = "Send it through"; }
    }
  });
})();
</script>
