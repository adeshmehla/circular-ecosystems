</div>

<!-- FIX: is:inline prevents Astro bundling this as an ES module,
     which could cause DOM queries to run before elements are ready -->
<script is:inline>
const DATA=[
 {window:"Open during structure planning and rezoning, while parcels, setbacks, corridor reservations, and easements are still on paper and nothing is poured.",
  lock:"First title transfer and the first major build. After that the distance between any two exchanging parties is fixed in concrete for the life of the precinct.",
  fail:"Streams that could have cascaded across a short internal run travel kilometres or get vented, because parcels were allocated for individual lot yield rather than exchange distance.",
  caps:"The distance-decay curve on every shared utility, and with it the recoverable by-product value across the whole precinct.",
  read:"Geometry sets the ceiling for everything that follows. No incentive moves a plant after the slab is down."},
 {window:"Open during tenant attraction, before the first anchor commits its supply and offtake.",
  lock:"The first anchor's contracts. Its input-output profile becomes the gravity well that every later tenant has to design its own economics around.",
  fail:"A precinct signs its largest emitter or consumer first on land-yield logic, then spends a decade chasing counterparties whose numbers never close because the anchor was placed and priced for itself.",
  caps:"Which exchanges are even possible later, and the economics every subsequent tenant inherits.",
  read:"The first signature decides the field of play. Sequencing the anchor for the system beats any later subsidy."},
 {window:"Open at the common-user infrastructure investment decision, while ownership and pricing of the water, energy, logistics, and by-product spine are still being structured.",
  lock:"The financing and operating model of that spine. Who owns it and how it prices access decides whether exchange is contractible at all.",
  fail:"By-product streams that pencil out technically die in commercial structuring, because no neutral party owns the connecting infrastructure and bilateral deals collapse under counterparty and tenure risk.",
  caps:"Whether the exchanges the geometry allows can actually be put under contract and financed.",
  read:"A dollar into the right shared spine supports many projects. The same dollar split across project subsidies supports one and seeds none."},
 {window:"Open at governance design, before the operating model is set and the roles harden around it.",
  lock:"The moment authority to make system-level trade-offs is either vested in a neutral holder or left unassigned. Unassigned is the default, and the default is itself a decision.",
  fail:"Every cross-boundary exchange gets renegotiated from zero, because no party can trade one proponent's interest against another's, so the system defaults to standalone projects that happen to share a fence line.",
  caps:"Whether the ceiling set by the first three commitments can ever actually be reached.",
  read:"Without a holder of system-level authority, nobody is positioned to act on the value the other three locks left on the table."}
];

const rail=document.getElementById('rail');
const nodes=[...rail.querySelectorAll('.node')];
const detail=document.getElementById('detail');
const fill=document.getElementById('lockfill');
let active=-1;

function setNode(i){
  if(active===i){ // toggle closed
    nodes[i].classList.remove('active');
    detail.classList.remove('show');
    active=-1; fill.style.width='0';
    return;
  }
  nodes.forEach(n=>n.classList.remove('active'));
  nodes[i].classList.add('active');
  active=i;
  const d=DATA[i];
  document.getElementById('d-window').textContent=d.window;
  document.getElementById('d-lock').textContent=d.lock;
  document.getElementById('d-fail').textContent=d.fail;
  document.getElementById('d-caps').textContent=d.caps;
  document.getElementById('d-read').textContent=d.read;
  detail.classList.add('show');
  fill.style.width=nodes[i].dataset.lock+'%';
}
nodes.forEach((n,i)=>n.addEventListener('click',()=>setNode(i)));

// scroll reveal
const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}})},{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
</script>
</body>
</html>