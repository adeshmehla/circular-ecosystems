---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { createClient, OAuthStrategy } from '@wix/sdk';
import { posts } from '@wix/blog';
import { wixImageUrl } from '../../lib/wixImage';

const wixClient = createClient({
  modules: { posts },
  auth: OAuthStrategy({
    clientId: import.meta.env.WIX_CLIENT_ID,
  }),
});

let allPosts: any[] = [];
try {
  const response = await wixClient.posts.listPosts({ paging: { limit: 50 } });
  allPosts = response.posts || [];
} catch (e) {
  console.error('Blog fetch failed:', e);
}

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-AU', { month: 'short', year: 'numeric' });
}
---

<Layout title="Insights — Circular Ecosystems" description="Working papers and briefings from Circular Ecosystems.">
  <Navbar />
  <section class="insights" style="padding-top: 160px; min-height: 80vh;">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">From the firm</span>
        <h2 class="h2">Insights &amp; Working Papers</h2>
        <p class="lead" style="margin-top: 22px;">
          Working papers, briefings, and analysis from Circular Ecosystems.
        </p>
      </div>

      {allPosts.length === 0 ? (
        <p style="font-family: 'DM Mono'; color: var(--mint); font-size: 13px; letter-spacing: .1em; margin-top: 60px; text-align: center;">
          Working papers coming soon.
        </p>
      ) : (
        <div class="ins-grid">
          {allPosts.map((post) => {
            const imgSrc = wixImageUrl(post.media?.wixMedia?.image, 680, 360);
            return (
              <a class="icard" href={`/blog/${post.slug}`}>
                {imgSrc && (
                  <div class="icard-img">
                    <img src={imgSrc} alt={post.title} loading="lazy" />
                  </div>
                )}
                <span class="itag">{post.categories?.[0]?.label || 'Insight'} · {formatDate(post._createdDate)}</span>
                <h3>{post.title}</h3>
                <p>{post.excerpt || ''}</p>
                <span class="ireq">Read more &rarr;</span>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>
  <Footer />
</Layout>
